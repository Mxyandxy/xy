# 服务端口（本地开发）
PORT=3000

# JWT 密钥（生产环境必须修改）
JWT_SECRET=please-change-this-secret

# Turso 数据库
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 图片存储（二选一，不配则本地磁盘）

# 方案 A：ImgBB 免费图床（推荐，不用绑卡）
# 注册 https://imgbb.com 获取 API Key
IMGBB_API_KEY=

# 方案 B：Cloudflare R2（需要绑卡）
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=campus-forum-uploads
R2_PUBLIC_URL=
