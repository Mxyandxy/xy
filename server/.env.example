# 服务端口（本地开发）
PORT=3000

# JWT 密钥（生产环境必须修改）
JWT_SECRET=please-change-this-secret

# Supabase 数据库（Postgres 连接串）
# Supabase 控制台 → Project Settings → Database → Connection string → URI
# 建议用 Session pooler / 直连串；如果带 ?pgbouncer=true 也可直接用
DATABASE_URL=postgresql://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 图片存储（二选一，不配则本地磁盘）

# 方案 A：ImgBB 免费图床（推荐，不用绑卡）
# 注册 https://imgbb.com 获取 API Key
IMGBB_API_KEY=

# 方案 B：Cloudflare R2（需要绑卡）
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=campus-forum-uploads
R2_PUBLIC_URL=
